# ==============================================================================
# Application Environment Variables Template
# Copy this file to '.env' and adjust the values according to your environment.
# ==============================================================================

# ---------------- Server ----------------
HOST=localhost
PORT=8080

# ---------------- PostgreSQL ----------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=task_manager_db
DB_SSLMODE=disable

# ---------------- Redis ----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------- MongoDB ----------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=task_manager_db
